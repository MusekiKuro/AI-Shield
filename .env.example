# Read by the application server from the project root. Never use VITE_* for secrets.
DEMO_MODE=true
DATABASE_URL=sqlite:///./data/app.db
DECISION_TIMEOUT_MS=3000
APPROVAL_TTL_SECONDS=120

# OpenAI-compatible API roots, INCLUDING /v1. Blank = skip this stage.
LLM_BASE_URL=
LLM_MODEL=gemma-4-12b-shield
LLM_API_KEY=
LLM_TIMEOUT_MS=2500
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=

# STT server root WITHOUT /v1. Blank = hide microphone controls.
STT_BASE_URL=
STT_API_KEY=
STT_TIMEOUT_MS=8000
